!l.M2_VXSS                      := 10.6;  ! Vacuum chamber T6VXSS, length [m]
! ===== SCRAPER MULTIPOLE QUADRUPOLE STRENGTHS (knob-driven) =====
! Fit parameters for quadrupole term (order=2): can be changed for systematic/uncertainty studies

scrA := 4.633689e-4*1e3;      ! amplitude [T/m]
scrl := 16.721577*1e-3;        ! decay length [m]
scrC := 4.065420e-5*1e3;      ! offset [T/m]
scrD := 1.085028e-7*1e6;      ! linear term [T/m^2]

beam_momentum := 160.0;                ! beam momentum [GeV/c]
scaling := 0.299792458/beam_momentum;  ! scaling factor for conversion from T/m to kG/cm
! Each scraper quadrupole strength (as function of the actual aperture value in mm)
kQuad.XCMH.X0610727_SCR3H := -1*scaling*(scrA * exp(-kXCMH.X0610727_SCR3H_COLL1H / scrl) + scrC + scrD * kXCMH.X0610727_SCR3H_COLL1H);
kQuad.XCMH.X0610752_SCR6H := -1*scaling*(scrA * exp(-kXCMH.X0610752_SCR6H_COLL2H / scrl) + scrC + scrD * kXCMH.X0610752_SCR6H_COLL2H);
kQuad.XCMH.X0610845_SCR7H := -1*scaling*(scrA * exp(-kXCMH.X0610845_SCR7H_COLL3H / scrl) + scrC + scrD * kXCMH.X0610845_SCR7H_COLL3H);

kQuad.XCMV.X0610190_SCR1V := 1*scaling*(scrA * exp(-kXCMV.X0610190_SCR1V_COLL4V / scrl) + scrC + scrD * kXCMV.X0610190_SCR1V_COLL4V);
kQuad.XCMV.X0610715_SCR2V := 1*scaling*(scrA * exp(-kXCMV.X0610715_SCR2V_COLL5V / scrl) + scrC + scrD * kXCMV.X0610715_SCR2V_COLL5V);
kQuad.XCMV.X0610733_SCR4V := 1*scaling*(scrA * exp(-kXCMV.X0610733_SCR4V_COLL6V / scrl) + scrC + scrD * kXCMV.X0610733_SCR4V_COLL6V);
kQuad.XCMV.X0610741_SCR5V := 1*scaling*(scrA * exp(-kXCMV.X0610741_SCR5V_COLL7V / scrl) + scrC + scrD * kXCMV.X0610741_SCR5V_COLL7V);
kQuad.XCMV.X0610997_SCR8V := 1*scaling*(scrA * exp(-kXCMV.X0610997_SCR8V_COLL8V / scrl) + scrC + scrD * kXCMV.X0610997_SCR8V_COLL8V);
kQuad.XCMV.X0611050_SCR9V := 1*scaling*(scrA * exp(-kXCMV.X0611050_SCR9V_COLL9V / scrl) + scrC + scrD * kXCMV.X0611050_SCR9V_COLL9V);

